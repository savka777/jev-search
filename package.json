{
  "name": "jev-search",
  "version": "0.1.0",
  "description": "Fast deep research for the pi coding agent: reads up to 100 pages in full per round, Jev keeps only the passages that answer your questions.",
  "keywords": [
    "pi-package",
    "pi",
    "research",
    "web-search",
    "deep-research",
    "typesafe",
    "jev"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savka777/jev-search.git"
  },
  "homepage": "https://github.com/savka777/jev-search#readme",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "pages": "node bench/pages.ts",
    "bench": "node bench/run.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@typesafe-ai/sdk": "^0.6.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^26.6.2",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
